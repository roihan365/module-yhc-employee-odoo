                <page string="Catatan Tambahan">
                    <field name="note" placeholder="Masukkan catatan tambahan tentang pelatihan..."/>
                </page>
            </notebook>
          </page> -->
      </xpath>

      <xpath expr="//field[@name='place_of_birth']" position="attributes">
        <attribute name="string">Tempat Lahir</attribute>
      </xpath>
      <xpath expr="//field[@name='birthday']" position="attributes">
        <attribute name="string">Tanggal Lahir</attribute>
      </xpath>
      <xpath expr="//field[@name='age']" position="attributes">
        <attribute name="string">Usia</attribute>
      </xpath>

    </field>
  </record>

  <!-- <record id="view_employee_form_inherit_hide_resume" model="ir.ui.view">
    <field name="name">hr.employee.form.inherit.hide.resume</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr_skills.hr_employee_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//page[@name='skills_resume']" position="attributes">
            <attribute name="invisible">1</attribute>
