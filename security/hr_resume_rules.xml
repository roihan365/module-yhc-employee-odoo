<odoo>
  <!-- Izinkan Admin & HR akses penuh ke hr.resume.line -->
  <record id="hr_resume_line_admin_rule" model="ir.rule">
      <field name="name">Resume Lines: Admin &amp; HR full access</field>
      <field name="model_id" ref="hr_skills.model_hr_resume_line"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('base.group_system')),
                                  (4, ref('hr.group_hr_manager')),
                                  (4, ref('hr.group_hr_user'))]"/>
  </record>
</odoo>
