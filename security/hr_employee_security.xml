        <field name="groups" eval="[
            (4, ref('yhc_employee.group_hr_polhas')),
            (4, ref('yhc_employee.group_hr_gibs')),
            (4, ref('yhc_employee.group_hr_wls')),
            (4, ref('yhc_employee.group_hr_annur')),
            (4, ref('yhc_employee.group_hr_office8'))
        ]"/>
    </record>

    <record id="rule_hr_partner_read" model="ir.rule">
        <field name="name">HR Area: read partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[
            (4, ref('yhc_employee.group_hr_polhas')),
