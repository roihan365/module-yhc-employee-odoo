<odoo>
    <record id="hr_employee_rule_hr_area" model="ir.rule">
        <field name="name">HR Area: see employees in same area</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[
            ('user_id','=',user.id),
            ('area_kerja_id', '!=', False),
            ('area_kerja_id', '=', user.employee_id.area_kerja_id.id)
        ]</field>
        <field name="groups" eval="[
            (4, ref('yhc_employee.group_hr_polhas')),
            (4, ref('yhc_employee.group_hr_gibs')),
            (4, ref('yhc_employee.group_hr_wls')),
            (4, ref('yhc_employee.group_hr_annur')),
            (4, ref('yhc_employee.group_hr_office8'))
        ]"/>
    </record>

    <record id="hr_employee_rule_self" model="ir.rule">
        <field name="name">Employee: can see own record only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="hr_employee_rule_admin" model="ir.rule">
        <field name="name">Admin: full access</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="hr_employee_public_rule_admin" model="ir.rule">
        <field name="name">Admin: full hr.employee.public</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- HR area boleh baca data pendukung yang sering direferensikan -->
    <record id="rule_hr_related_models" model="ir.rule">
        <field name="name">HR Area: can read related HR data</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[
            (4, ref('yhc_employee.group_hr_polhas')),
            (4, ref('yhc_employee.group_hr_gibs')),
            (4, ref('yhc_employee.group_hr_wls')),
            (4, ref('yhc_employee.group_hr_annur')),
            (4, ref('yhc_employee.group_hr_office8'))
        ]"/>
    </record>

    <record id="rule_hr_department_read" model="ir.rule">
        <field name="name">HR Area: read departments</field>
        <field name="model_id" ref="hr.model_hr_department"/>
        <field name="domain_force">[(1,'=',1)]</field>
